# Copie para .env.local e preencha com os valores do seu projeto Firebase
# (Console > Configurações do projeto > Seus apps > Configuração do SDK).
# Na Vercel, cadastre as mesmas chaves em Settings > Environment Variables.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
